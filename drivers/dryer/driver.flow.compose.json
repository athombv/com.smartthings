        "ko": "원격 제어 !{{활성화됨|비활성화됨}}"
      },
      "$filter": {
        "capabilities": "samsung_dryer_remote_control_enabled"
      }
    }
  ],
  "actions": [
    {
      "id": "set_dryer_state",
      "title": {
        "en": "Set dryer state to...",
        "nl": "Zet droger status naar..."
      },
      "titleFormatted": {
        "en": "Set dryer state to [[state]]",
        "nl": "Zet droger status naar [[state]]"
      },
      "hint": {
        "en": "Samsung Smart Control (Remote Start) must be enabled on your dryer for this flow card to work."
      },
      "args": [
        {
          "name": "state",
          "type": "dropdown",
          "title": { "en": "State", "nl": "Status" },
          "placeholder": { "en": "Choose state", "nl": "Kies status" },
          "values": [
            { "id": "run", "title": { "en": "Run" } },
            { "id": "pause", "title": { "en": "Pause" } },
            { "id": "stop", "title": { "en": "Stop" } }
          ]
        }
      ]
    },
    {
      "id": "set_dryer_cycle",
      "title": {
        "en": "Set drying program to...",
        "nl": "Stel droogprogramma in op...",
        "de": "Trockenprogramm einstellen auf...",
        "fr": "Définir le programme de séchage sur...",
        "es": "Establecer programa de secado en...",
        "it": "Imposta programma di asciugatura su...",
        "no": "Angi tørkeprogram til...",
        "sv": "Ange torkprogram till...",
        "da": "Indstil tørreprogram til...",
