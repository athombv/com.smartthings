      "titleFormatted": {
        "en": "Set drying program to [[cycle]]",
        "nl": "Stel droogprogramma in op [[cycle]]"
      },
      "hint": {
        "en": "Samsung Smart Control (Remote Start) must be enabled and the dryer must be idle before selecting a program."
      },
      "args": [
        {
          "name": "cycle",
          "type": "dropdown",
          "title": { "en": "Program", "nl": "Programma" },
