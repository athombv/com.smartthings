        "en": "Remote Start !{{is|is not}} enabled",
        "nl": "Afstandsbediening !{{is|is niet}} ingeschakeld",
        "de": "Fernstart !{{ist|ist nicht}} aktiviert",
        "fr": "Démarrage à distance !{{est|n'est pas}} activé",
